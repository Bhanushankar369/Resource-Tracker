# Backend configuration. Copy to .env and fill in.
#   cp backend/.env.example backend/.env
#
# The Groq key lives HERE and never in the Android app. Anything in this file is
# read by the server process only. The repo-root .env is a different file and holds
# only the non-secret values the APK is compiled with.

# --- general -----------------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO
# Comma separated. Blank means "same origin only", which is the safe default.
# Set it to your web app's origin (e.g. http://localhost:5173) if a browser calls
# this API. Never use "*" in production. The Android client does not need CORS.
# CORS_ORIGINS=http://localhost:5173

# --- database ----------------------------------------------------------------
# Leave blank to use the bundled SQLite file (backend/storage/resourcetracker.sqlite3).
# Point at Postgres for anything real:
#   DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/resourcetracker
DATABASE_URL=

# --- identity ---------------------------------------------------------------
# Authentication has been removed; this is a single-tenant backend. Every request
# operates as this one user, and the id is stamped onto every card and job row.
LOCAL_USER_ID=local-user

# --- abuse limits -------------------------------------------------------------
# Max POST /v1/reels per client per minute. Each submit can spend LLM credit.
SUBMIT_RATE_LIMIT_PER_MINUTE=30

# --- Groq --------------------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
# llama-3.3-70b-versatile and llama-3.1-8b-instant are retired (404 model_not_found).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_RETRIES=2
GROQ_TIMEOUT_SECONDS=60

# --- transcript providers ----------------------------------------------------
# Providers: manual, oembed, whisper, youtube, x_twitter.
# By default, YouTube and X/Twitter URLs are automatically routed to their respective providers.
TRANSCRIPT_PROVIDER=oembed
# Tried in order if the first one has nothing to offer.
TRANSCRIPT_PROVIDER_FALLBACKS=oembed,youtube,x_twitter
OEMBED_TIMEOUT_SECONDS=15

# --- YouTube metadata (optional) ---------------------------------------------
# YouTube oEmbed is keyless and returns title, author, and thumbnail automatically.
# YOUTUBE_API_KEY is optional and used for richer descriptions/tags via Data API v3.
YOUTUBE_API_KEY=

# --- Instagram metadata ------------------------------------------------------
# REQUIRED for the `oembed` provider to read anything. Instagram retired all of its
# unauthenticated metadata endpoints, so caption, hashtags and creator name can only
# come from Meta's Graph oEmbed, and that needs an app token.
#
#   "<app-id>|<app-secret>"   an app access token, from developers.facebook.com
#                             -> your app -> App Settings -> Basic, App ID + App Secret
#
# A user access token from an app with the Instagram oEmbed permission also works.
# See README, "Instagram metadata", for what the app needs before this returns
# anything for a reel you did not post yourself.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_VERSION=v21.0

# whisper: needs a media resolver, so it usually cannot read a reel on its own.
# Speech-to-text also runs on Groq, so WHISPER_API_KEY defaults to GROQ_API_KEY.
# whisper-1 is an OpenAI name and does not exist on Groq.
WHISPER_API_KEY=
WHISPER_MODEL=whisper-large-v3

# --- media / OCR -------------------------------------------------------------
OCR_ENABLED=true
# Frames sampled for OCR. More frames means better recall and more CPU.
OCR_FRAME_COUNT=8
MAX_MEDIA_BYTES=209715200
DOWNLOAD_TIMEOUT_SECONDS=60
# ffmpeg and tesseract must be installed and on PATH for OCR to work.
FFMPEG_BINARY=ffmpeg

# --- job runner --------------------------------------------------------------
# In-process worker threads. Move to Celery/RQ to scale out.
JOB_WORKER_THREADS=2
JOB_TIMEOUT_SECONDS=600
JOB_MAX_ATTEMPTS=2

# --- temp storage ------------------------------------------------------------
# Every job writes here and the directory is deleted when the job ends.
# Leave blank to use backend/storage/workspace. Do NOT set this to an empty value
# on its own line in a shell that resolves it to the current directory.
# The janitor below is the backstop for crashes and hard power loss.
WORKSPACE_DIR=
JANITOR_INTERVAL_SECONDS=900
JANITOR_MAX_AGE_SECONDS=3600
