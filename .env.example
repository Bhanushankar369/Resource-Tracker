# ===========================================================================
#  ResourceTracker - local development environment
#  Copy to `.env` and fill in. `.env` is git-ignored. Never commit it.
#
#  Values here are baked into the APK's BuildConfig at build time and can be
#  recovered by anyone who unzips the APK. That is acceptable for a local
#  backend URL. It is NOT acceptable for a Groq key.
#  Groq keys live only in backend/.env - never in this file.
# ===========================================================================

# ---- App flavour ----------------------------------------------------------
# "dev" or "prod". Dev enables the in-app debug affordances and local logging.
APP_ENV=dev

# ---- Backend --------------------------------------------------------------
# Android emulator:  10.0.2.2  ->  the host machine's localhost
# Physical device:    use your machine's LAN IP, e.g. http://192.168.1.42:8000/
# Trailing slash is required by Retrofit/OkHttp.
BACKEND_BASE_URL=http://10.0.2.2:8000/
